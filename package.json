{
	"name": "create-not-learn-editor",
	"version": "0.2.0",
	"description": "A standalone experimental WordPress site editor plugin.",
	"private": true,
	"license": "GPL-2.0-or-later",
	"files": [
		"assets",
		"build",
		"create-not-learn-editor.php",
		"includes",
		"patterns",
		"README.md"
	],
	"scripts": {
		"build": "wp-build",
		"dev": "wp-build --watch",
		"start": "wp-build --watch",
		"test:e2e": "playwright test",
		"test:e2e:smoke": "playwright test tests/e2e/smoke.spec.js",
		"test:e2e:views": "playwright test tests/e2e/views",
		"test:e2e:interactions": "playwright test tests/e2e/interactions",
		"test:unit": "wp-scripts test-unit-js",
		"sync:list-view": "node scripts/sync-gutenberg-list-view.mjs",
		"check:list-view": "node scripts/sync-gutenberg-list-view.mjs --check",
		"lint:js": "wp-scripts lint-js src routes scripts playwright.config.js vitest.config.mjs tests/e2e tests/unit",
		"lint:css": "wp-scripts lint-style 'src/**/*.scss' 'packages/*/src/**/*.scss'",
		"plugin-zip": "wp-scripts plugin-zip",
		"wp-env": "node scripts/wp-env.mjs",
		"wporg-assets": "node scripts/render-wordpress-org-assets.mjs"
	},
	"wpPlugin": {
		"name": "cnl_editor",
		"scriptGlobal": false,
		"packageNamespace": "create-not-learn-editor",
		"handlePrefix": "create-not-learn-editor",
		"pages": [
			{
				"id": "create-not-learn-editor",
				"init": [
					"@create-not-learn-editor/app-init"
				]
			}
		]
	},
	"dependencies": {
		"@base-ui/react": "^1.9.0",
		"@wordpress/admin-ui": "^2.12.0",
		"@wordpress/api-fetch": "^7.57.0",
		"@wordpress/block-editor": "^18.1.0",
		"@wordpress/block-library": "^11.2.0",
		"@wordpress/block-serialization-default-parser": "^5.57.0",
		"@wordpress/blocks": "^16.2.0",
		"@wordpress/boot": "^0.24.0",
		"@wordpress/commands": "^1.57.0",
		"@wordpress/components": "^42.0.0",
		"@wordpress/core-data": "^8.2.0",
		"@wordpress/data": "^10.57.0",
		"@wordpress/dataviews": "^20.0.0",
		"@wordpress/editor": "^15.2.0",
		"@wordpress/element": "^9.0.0",
		"@wordpress/escape-html": "^3.57.0",
		"@wordpress/hooks": "^4.57.0",
		"@wordpress/html-entities": "^4.57.0",
		"@wordpress/i18n": "^6.30.0",
		"@wordpress/icons": "^18.0.0",
		"@wordpress/keyboard-shortcuts": "^5.57.0",
		"@wordpress/keycodes": "^4.57.0",
		"@wordpress/lazy-editor": "^1.23.0",
		"@wordpress/media-utils": "^5.57.0",
		"@wordpress/notices": "^5.57.0",
		"@wordpress/preferences": "^4.57.0",
		"@wordpress/private-apis": "^2.0.0",
		"@wordpress/route": "^0.23.0",
		"@wordpress/theme": "^2.3.0",
		"@wordpress/ui": "^0.24.0",
		"@wordpress/url": "^4.57.0"
	},
	"devDependencies": {
		"@playwright/test": "1.64.1",
		"@wordpress/build": "^0.25.0",
		"@wordpress/env": "^11.17.0",
		"@wordpress/scripts": "^36.1.0",
		"jsdom": "^26.1.0",
		"vite": "^8.3.4",
		"vitest": "^5.0.4"
	}
}
