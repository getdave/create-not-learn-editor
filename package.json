{
	"name": "create-not-learn-editor",
	"version": "0.1.0",
	"description": "A standalone experimental WordPress site editor plugin.",
	"private": true,
	"license": "GPL-2.0-or-later",
	"files": [
		"assets",
		"build",
		"create-not-learn-editor.php",
		"includes",
		"patterns",
		"README.md"
	],
	"scripts": {
		"build": "wp-build",
		"dev": "wp-build --watch",
		"start": "wp-build --watch",
		"test:e2e": "playwright test",
		"test:unit": "wp-scripts test-unit-js",
		"sync:list-view": "node scripts/sync-gutenberg-list-view.mjs",
		"check:list-view": "node scripts/sync-gutenberg-list-view.mjs --check",
		"lint:js": "wp-scripts lint-js src routes scripts playwright.config.js jest-unit.config.js tests/e2e tests/unit",
		"lint:css": "wp-scripts lint-style 'src/**/*.scss' 'packages/*/src/**/*.scss'",
		"plugin-zip": "wp-scripts plugin-zip",
		"wp-env": "node scripts/ensure-canvas-plugin.mjs && wp-env"
	},
	"wpPlugin": {
		"name": "cnl_editor",
		"scriptGlobal": false,
		"packageNamespace": "create-not-learn-editor",
		"handlePrefix": "create-not-learn-editor",
		"pages": [
			{
				"id": "create-not-learn-editor",
				"init": [
					"@create-not-learn-editor/app-init"
				]
			}
		]
	},
	"dependencies": {
		"@wordpress/admin-ui": "^2.10.0",
		"@wordpress/api-fetch": "^7.55.0",
		"@wordpress/block-editor": "^17.1.0",
		"@wordpress/block-library": "^11.0.0",
		"@wordpress/block-serialization-default-parser": "^5.55.0",
		"@wordpress/blocks": "^16.0.0",
		"@wordpress/boot": "^0.22.0",
		"@wordpress/commands": "^1.55.0",
		"@wordpress/components": "^40.1.0",
		"@wordpress/core-data": "^8.0.0",
		"@wordpress/data": "^10.55.0",
		"@wordpress/dataviews": "^19.0.0",
		"@wordpress/editor": "^15.0.0",
		"@wordpress/element": "^8.7.0",
		"@wordpress/escape-html": "^3.55.0",
		"@wordpress/hooks": "^4.55.0",
		"@wordpress/html-entities": "^4.55.0",
		"@wordpress/i18n": "^6.28.0",
		"@wordpress/icons": "^16.0.0",
		"@wordpress/keycodes": "^4.55.0",
		"@wordpress/lazy-editor": "^1.21.0",
		"@wordpress/media-utils": "^5.55.0",
		"@wordpress/notices": "^5.55.0",
		"@wordpress/preferences": "^4.55.0",
		"@wordpress/private-apis": "^1.55.0",
		"@wordpress/route": "^0.21.0",
		"@wordpress/theme": "^2.1.0",
		"@wordpress/ui": "^0.22.0",
		"@wordpress/url": "^4.55.0"
	},
	"devDependencies": {
		"@playwright/test": "1.61.1",
		"@wordpress/build": "^0.23.0",
		"@wordpress/env": "^11.15.0",
		"@wordpress/scripts": "^35.0.0"
	}
}
