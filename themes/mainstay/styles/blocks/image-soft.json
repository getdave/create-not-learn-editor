{
	"$schema": "https://schemas.wp.org/trunk/theme.json",
	"version": 3,
	"title": "Soft corners",
	"slug": "mainstay-soft",
	"blockTypes": [
		"core/image",
		"core/post-featured-image",
		"core/cover"
	],
	"styles": {
		"border": {
			"radius": "20px"
		},
