{
	"$schema": "https://schemas.wp.org/trunk/theme.json",
	"version": 3,
	"title": "Simple",
	"styles": {
		"typography": {
			"fontFamily": "var:preset|font-family|inter",
			"lineHeight": "1.6"
		},
		"elements": {
			"heading": {
				"typography": {
					"fontFamily": "var:preset|font-family|inter",
					"fontWeight": "650",
					"letterSpacing": "-0.035em",
					"lineHeight": "1.08"
				}
			},
			"h1": {
				"typography": {
					"letterSpacing": "-0.035em"
				}
			},
			"h2": {
				"typography": {
					"letterSpacing": "-0.035em"
				}
			}
		},
		"blocks": {
			"core/site-title": {
				"typography": {
					"fontFamily": "var:preset|font-family|inter",
					"fontWeight": "650"
				}
			},
			"core/pullquote": {
				"typography": {
					"fontFamily": "var:preset|font-family|inter",
					"fontWeight": "650"
				}
			}
		}
	}
}
