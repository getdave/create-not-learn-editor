{
	"$schema": "https://schemas.wp.org/trunk/theme.json",
	"version": 3,
	"title": "Editorial",
	"styles": {
		"typography": {
			"fontFamily": "var:preset|font-family|instrument-sans",
			"lineHeight": "1.6"
		},
		"elements": {
			"heading": {
				"typography": {
					"fontFamily": "var:preset|font-family|instrument-serif",
					"fontWeight": "400",
					"letterSpacing": "-0.01em",
					"lineHeight": "1.05"
				}
			},
			"h1": {
				"typography": {
					"letterSpacing": "-0.01em"
				}
			},
			"h2": {
				"typography": {
					"letterSpacing": "-0.01em"
				}
			}
		},
		"blocks": {
			"core/site-title": {
				"typography": {
					"fontFamily": "var:preset|font-family|instrument-serif",
					"fontWeight": "400"
				}
			},
			"core/pullquote": {
				"typography": {
					"fontFamily": "var:preset|font-family|instrument-serif",
					"fontWeight": "400"
				}
			}
		}
	}
}
