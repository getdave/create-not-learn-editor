{
	"$schema": "https://schemas.wp.org/trunk/theme.json",
	"version": 3,
	"settings": {
		"appearanceTools": true,
		"useRootPaddingAwareAlignments": true,
		"color": {
			"defaultDuotone": false,
			"defaultGradients": false,
			"defaultPalette": false,
			"palette": [
				{
					"color": "#FBFBF8",
					"name": "Background",
					"slug": "base"
				},
				{
					"color": "#15241C",
					"name": "Text",
					"slug": "contrast"
				},
				{
					"color": "#2E6B4F",
					"name": "Primary",
					"slug": "accent-1"
				},
				{
					"color": "#F2C14E",
					"name": "Highlight",
					"slug": "accent-2"
				},
				{
					"color": "#E4DDF4",
					"name": "Tint",
					"slug": "accent-3"
				},
				{
					"color": "#EDF1EA",
					"name": "Soft background",
					"slug": "base-2"
				},
				{
					"color": "#4B5B52",
					"name": "Soft text",
					"slug": "contrast-2"
				}
			]
		},
		"layout": {
			"contentSize": "720px",
			"wideSize": "1240px"
		},
		"shadow": {
			"defaultPresets": false,
			"presets": [
				{
					"name": "Soft",
					"slug": "soft",
					"shadow": "0 18px 40px -20px rgb(21 36 28 / 0.35)"
				}
			]
		},
		"spacing": {
			"defaultSpacingSizes": false,
			"spacingSizes": [
				{
					"name": "Tiny",
					"size": "0.5rem",
					"slug": "20"
				},
				{
					"name": "X-Small",
					"size": "1rem",
					"slug": "30"
				},
				{
					"name": "Small",
					"size": "clamp(1.25rem, 3vw, 2rem)",
					"slug": "40"
				},
				{
					"name": "Medium",
					"size": "clamp(2rem, 5vw, 3.5rem)",
					"slug": "50"
				},
				{
					"name": "Large",
					"size": "clamp(2.75rem, 6.5vw, 5rem)",
					"slug": "60"
				},
				{
					"name": "X-Large",
					"size": "clamp(4rem, 11vw, 8.5rem)",
					"slug": "70"
				},
				{
					"name": "XX-Large",
					"size": "clamp(5rem, 14vw, 11rem)",
					"slug": "80"
				}
			],
			"units": [
				"%",
				"px",
				"em",
				"rem",
				"vh",
				"vw"
			]
		},
		"typography": {
			"defaultFontSizes": false,
			"fluid": true,
			"writingMode": true,
			"fontSizes": [
				{
					"name": "Small",
					"size": "0.9375rem",
					"slug": "small",
					"fluid": false
				},
				{
					"name": "Medium",
					"size": "1.125rem",
					"slug": "medium",
					"fluid": {
						"min": "1.0625rem",
						"max": "1.1875rem"
					}
				},
				{
					"name": "Large",
					"size": "1.5rem",
					"slug": "large",
					"fluid": {
						"min": "1.3125rem",
						"max": "1.625rem"
					}
				},
				{
					"name": "Extra Large",
					"size": "2.25rem",
					"slug": "x-large",
					"fluid": {
						"min": "1.75rem",
						"max": "2.5rem"
					}
				},
				{
					"name": "Extra Extra Large",
					"size": "3.5rem",
					"slug": "xx-large",
					"fluid": {
						"min": "2.375rem",
						"max": "4rem"
					}
				},
				{
					"name": "Huge",
					"size": "5.5rem",
					"slug": "huge",
					"fluid": {
						"min": "3rem",
						"max": "6.75rem"
					}
				}
			],
			"fontFamilies": [
				{
					"name": "Bricolage Grotesque",
					"slug": "bricolage-grotesque",
					"fontFamily": "\"Bricolage Grotesque\", ui-sans-serif, system-ui, sans-serif",
					"fontFace": [
						{
							"fontFamily": "Bricolage Grotesque",
							"fontStyle": "normal",
							"fontWeight": "200 800",
							"fontStretch": "75% 100%",
							"fontDisplay": "swap",
							"src": [
								"file:./assets/fonts/bricolage-grotesque.woff2"
							]
						}
					]
				},
				{
					"name": "Instrument Serif",
					"slug": "instrument-serif",
					"fontFamily": "\"Instrument Serif\", ui-serif, Georgia, serif",
					"fontFace": [
						{
							"fontFamily": "Instrument Serif",
							"fontStyle": "normal",
							"fontWeight": "400",
							"fontDisplay": "swap",
							"src": [
								"file:./assets/fonts/instrument-serif.woff2"
							]
						},
						{
							"fontFamily": "Instrument Serif",
							"fontStyle": "italic",
							"fontWeight": "400",
							"fontDisplay": "swap",
							"src": [
								"file:./assets/fonts/instrument-serif-italic.woff2"
							]
						}
					]
				},
				{
					"name": "Instrument Sans",
					"slug": "instrument-sans",
					"fontFamily": "\"Instrument Sans\", ui-sans-serif, system-ui, sans-serif",
					"fontFace": [
						{
							"fontFamily": "Instrument Sans",
							"fontStyle": "normal",
							"fontWeight": "400 700",
							"fontDisplay": "swap",
							"src": [
								"file:./assets/fonts/instrument-sans.woff2"
							]
						},
						{
							"fontFamily": "Instrument Sans",
							"fontStyle": "italic",
							"fontWeight": "400 700",
							"fontDisplay": "swap",
							"src": [
								"file:./assets/fonts/instrument-sans-italic.woff2"
							]
						}
					]
				},
				{
					"name": "Newsreader",
					"slug": "newsreader",
					"fontFamily": "Newsreader, ui-serif, Georgia, serif",
					"fontFace": [
						{
							"fontFamily": "Newsreader",
							"fontStyle": "normal",
							"fontWeight": "200 800",
							"fontDisplay": "swap",
							"src": [
								"file:./assets/fonts/newsreader.woff2"
							]
						},
						{
							"fontFamily": "Newsreader",
							"fontStyle": "italic",
							"fontWeight": "200 800",
							"fontDisplay": "swap",
							"src": [
								"file:./assets/fonts/newsreader-italic.woff2"
							]
						}
					]
				},
				{
					"name": "Inter",
					"slug": "inter",
					"fontFamily": "Inter, ui-sans-serif, system-ui, sans-serif",
					"fontFace": [
						{
							"fontFamily": "Inter",
							"fontStyle": "normal",
							"fontWeight": "100 900",
							"fontDisplay": "swap",
							"src": [
								"file:./assets/fonts/inter.woff2"
							]
						},
						{
							"fontFamily": "Inter",
							"fontStyle": "italic",
							"fontWeight": "100 900",
							"fontDisplay": "swap",
							"src": [
								"file:./assets/fonts/inter-italic.woff2"
							]
						}
					]
				}
			]
		}
	},
	"styles": {
		"color": {
			"background": "var:preset|color|base",
			"text": "var:preset|color|contrast"
		},
		"spacing": {
			"blockGap": "1.25rem",
			"padding": {
				"top": "0px",
				"right": "var:preset|spacing|40",
				"bottom": "0px",
				"left": "var:preset|spacing|40"
			}
		},
		"typography": {
			"fontFamily": "var:preset|font-family|bricolage-grotesque",
			"fontSize": "var:preset|font-size|medium",
			"fontWeight": "400",
			"letterSpacing": "-0.005em",
			"lineHeight": "1.6"
		},
		"elements": {
			"button": {
				"border": {
					"radius": "999px"
				},
				"color": {
					"background": "var:preset|color|accent-1",
					"text": "var:preset|color|base"
				},
				"spacing": {
					"padding": {
						"top": "0.85rem",
						"right": "1.6rem",
						"bottom": "0.85rem",
						"left": "1.6rem"
					}
				},
				"typography": {
					"fontSize": "var:preset|font-size|small",
					"fontWeight": "600",
					"letterSpacing": "0",
					"lineHeight": "1.2"
				},
				":hover": {
					"color": {
						"background": "var:preset|color|contrast",
						"text": "var:preset|color|base"
					}
				},
				":focus": {
					"color": {
						"background": "var:preset|color|contrast",
						"text": "var:preset|color|base"
					},
					"outline": {
						"color": "var:preset|color|accent-1",
						"offset": "3px",
						"style": "solid",
						"width": "2px"
					}
				}
			},
			"caption": {
				"typography": {
					"fontSize": "var:preset|font-size|small",
					"lineHeight": "1.45"
				}
			},
			"heading": {
				"typography": {
					"fontFamily": "var:preset|font-family|bricolage-grotesque",
					"fontWeight": "700",
					"letterSpacing": "-0.025em",
					"lineHeight": "1.08"
				}
			},
			"h1": {
				"typography": {
					"fontSize": "var:preset|font-size|xx-large",
					"lineHeight": "1.04",
					"letterSpacing": "-0.03em"
				}
			},
			"h2": {
				"typography": {
					"fontSize": "var:preset|font-size|x-large",
					"letterSpacing": "-0.03em"
				}
			},
			"h3": {
				"typography": {
					"fontSize": "var:preset|font-size|large"
				}
			},
			"h4": {
				"typography": {
					"fontSize": "1.25rem",
					"letterSpacing": "-0.015em"
				}
			},
			"h5": {
				"typography": {
					"fontSize": "var:preset|font-size|medium",
					"letterSpacing": "-0.01em"
				}
			},
			"h6": {
				"typography": {
					"fontSize": "var:preset|font-size|small",
					"letterSpacing": "0"
				}
			},
			"link": {
				"color": {
					"text": "currentColor"
				},
				"typography": {
					"textDecoration": "underline"
				},
				":hover": {
					"typography": {
						"textDecoration": "none"
					}
				},
				":focus": {
					"outline": {
						"color": "currentColor",
						"offset": "3px",
						"style": "solid",
						"width": "2px"
					}
				}
			}
		},
		"blocks": {
			"core/button": {
				"variations": {
					"outline": {
						"border": {
							"color": "currentColor",
							"width": "1.5px"
						},
						"color": {
							"background": "transparent",
							"text": "currentColor"
						},
						"spacing": {
							"padding": {
								"top": "calc(0.85rem - 1.5px)",
								"right": "calc(1.6rem - 1.5px)",
								"bottom": "calc(0.85rem - 1.5px)",
								"left": "calc(1.6rem - 1.5px)"
							}
						}
					}
				}
			},
			"core/details": {
				"spacing": {
					"padding": {
						"top": "1.1rem",
						"bottom": "1.1rem"
					}
				}
			},
			"core/navigation": {
				"typography": {
					"fontSize": "var:preset|font-size|small",
					"fontWeight": "500"
				},
				"elements": {
					"link": {
						"typography": {
							"textDecoration": "none"
						},
						":hover": {
							"typography": {
								"textDecoration": "underline"
							}
						}
					}
				}
			},
			"core/post-date": {
				"typography": {
					"fontSize": "var:preset|font-size|small"
				},
				"elements": {
					"link": {
						"typography": {
							"textDecoration": "none"
						}
					}
				}
			},
			"core/post-terms": {
				"typography": {
					"fontSize": "var:preset|font-size|small"
				}
			},
			"core/post-title": {
				"elements": {
					"link": {
						"typography": {
							"textDecoration": "none"
						},
						":hover": {
							"typography": {
								"textDecoration": "underline"
							}
						}
					}
				}
			},
			"core/pullquote": {
				"border": {
					"width": "0"
				},
				"typography": {
					"fontFamily": "var:preset|font-family|bricolage-grotesque",
					"fontSize": "var:preset|font-size|x-large",
					"fontWeight": "600",
					"letterSpacing": "-0.02em",
					"lineHeight": "1.2"
				}
			},
			"core/quote": {
				"border": {
					"width": "0"
				},
				"spacing": {
					"padding": {
						"left": "0"
					}
				},
				"typography": {
					"fontSize": "var:preset|font-size|large",
					"fontWeight": "500",
					"letterSpacing": "-0.015em",
					"lineHeight": "1.35"
				},
				"elements": {
					"cite": {
						"typography": {
							"fontSize": "var:preset|font-size|small",
							"fontStyle": "normal",
							"fontWeight": "400",
							"letterSpacing": "0"
						}
					}
				}
			},
			"core/search": {
				"border": {
					"radius": "999px"
				},
				"typography": {
					"fontSize": "var:preset|font-size|small"
				}
			},
			"core/separator": {
				"border": {
					"bottom": {
						"style": "solid",
						"width": "1px"
					}
				}
			},
			"core/site-tagline": {
				"typography": {
					"fontSize": "var:preset|font-size|small"
				}
			},
			"core/site-title": {
				"typography": {
					"fontSize": "1.375rem",
					"fontWeight": "700",
					"letterSpacing": "-0.03em",
					"lineHeight": "1"
				},
				"elements": {
					"link": {
						"typography": {
							"textDecoration": "none"
						}
					}
				}
			}
		}
	},
	"templateParts": [
		{
			"area": "header",
			"name": "header",
			"title": "Header"
		},
		{
			"area": "footer",
			"name": "footer",
			"title": "Footer"
		}
	]
}
